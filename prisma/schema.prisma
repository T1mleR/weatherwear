generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Recommendation {
  id                 String   @id @default(uuid())
  city               String
  temperature        Float
  feelsLike          Float
  condition          String
  windSpeed          Float
  uvIndex            Float
  humidity           Float
  recommendationText String
  createdAt          DateTime @default(now())
}
