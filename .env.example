# Local development only. Replace before using a publicly reachable environment.
POSTGRES_USER=weatherwear
POSTGRES_DB=weatherwear
POSTGRES_PASSWORD=replace-with-a-long-alphanumeric-password
APP_PORT=3000

# For "npm run dev" outside Docker; change the password to match above.
DATABASE_URL=postgresql://weatherwear:replace-with-a-long-alphanumeric-password@localhost:5432/weatherwear?schema=public
